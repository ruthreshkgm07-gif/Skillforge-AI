# ==============================================================================
# SKILLFORGE AI - GLOBAL ENVIRONMENT VARIABLE TEMPLATE
# Copy to '.env' in local root for Docker Compose or local execution
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=skillforge_db
POSTGRES_USER=skillforge_user
POSTGRES_PASSWORD=skillforge_password_secret
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/skillforge_db
# For Neon serverless PostgreSQL in production:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xyz.neon.tech/skillforge_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. CACHE CONFIGURATION (Redis / Upstash)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# For Upstash Redis in production:
# REDIS_HOST=xyz.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password

# ------------------------------------------------------------------------------
# 3. BACKEND SECURITY & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=404D635166546A576E5A7234753778214125442A472D4B6150645267556B5870
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. OPENAI / GOOGLE GEMINI AI API
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 5. PYTHON ML SERVICE
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000

# ------------------------------------------------------------------------------
# 6. CLOUDINARY FILE STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Spring Mail + Gmail SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ------------------------------------------------------------------------------
# 8. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ML_API_BASE_URL=http://localhost:8000
